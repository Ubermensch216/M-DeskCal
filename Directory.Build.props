<Project>
  <PropertyGroup>
    <!-- One version for every program in the solution. Beta releases carry a -beta.N suffix. -->
    <Version>0.1.0-beta.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Company>M-DeskCal</Company>
    <Product>M-DeskCal</Product>
    <Copyright>Clean-room implementation; no code or assets from other products.</Copyright>
  </PropertyGroup>
</Project>
