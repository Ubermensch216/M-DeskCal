<Window x:Class="DeskCal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M-DeskCal" Width="640" Height="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- header icon buttons: one size, one hover/pressed state layer -->
        <Style x:Key="NavBtn" TargetType="Border">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#01FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#24FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#01FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Border x:Name="Frame" CornerRadius="14" Background="#99101820"
            BorderBrush="#1FFFFFFF" BorderThickness="1">
      <Grid>
        <!-- optional background photo (see ApplySkin) -->
        <Border x:Name="SkinLayer" CornerRadius="13" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Border Padding="12,10,12,12">
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MonthTitle" Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Border x:Name="ChatPromptBar" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MinWidth="96" MaxWidth="430" Margin="10,0,10,0" Padding="10,4"
                        CornerRadius="14" Background="#24FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1"
                        Cursor="Hand" MouseLeftButtonDown="ChatPrompt_MouseDown"
                        ToolTip="더블 클릭하여 캘린더 채팅 프롬프트 입력 (Enter 전송) · 여러 줄 글이나 캡처 이미지를 붙여넣으면 채팅 창에서 일정을 추출합니다">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Fill="#FF7EB6FF"
                              Data="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3zM5 17l.9 2.1L8 20l-2.1.9L5 23l-.9-2.1L2 20l2.1-.9L5 17z"/>
                        <TextBlock x:Name="ChatPromptTitle" DockPanel.Dock="Left" Text="캘린더 채팅"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#FFEAF2FF"
                                   VerticalAlignment="Center" Margin="6,0,8,0"/>
                        <Grid VerticalAlignment="Center">
                            <TextBlock x:Name="ChatPromptPlaceholder" Text="더블 클릭해 질문·일정 입력…"
                                       FontSize="11.5" Foreground="#99FFFFFF" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBox x:Name="ChatPromptBox" Visibility="Collapsed"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="White" CaretBrush="White" FontSize="12"
                                     VerticalAlignment="Center" MinWidth="120"
                                     PreviewKeyDown="ChatPromptBox_KeyDown"
                                     LostKeyboardFocus="ChatPromptBox_LostFocus"/>
                        </Grid>
                    </DockPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Compact sync result indicator: icons and numbers only -->
                    <Border x:Name="SyncResultBadge" Visibility="Collapsed" CornerRadius="10"
                            Padding="7,3" Margin="0,0,4,0" VerticalAlignment="Center"
                            BorderBrush="#44FFFFFF" BorderThickness="1"
                            Cursor="Hand" MouseLeftButtonDown="SyncResult_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#24FFFFFF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#38FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel x:Name="SyncResultContent" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Sync action button: icon only -->
                    <Border x:Name="SyncBtn" Padding="6,4" Margin="0,0,4,0" CornerRadius="6"
                            Cursor="Hand" VerticalAlignment="Center"
                            MouseLeftButtonDown="Sync_Click" ToolTip="동기화 실행 (우클릭: 동기화 설정)">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#01FFFFFF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#24FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Path x:Name="SyncIcon" Width="15" Height="15" Stretch="Uniform"
                              Stroke="White" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              RenderTransformOrigin="0.5,0.5"
                              Data="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16M16 16h5v5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SyncIconRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <!-- month navigation: vector chevrons (no text arrows), shared hover state, Today as a pill -->
                    <Border x:Name="PrevBtn" Style="{StaticResource NavBtn}"
                            MouseLeftButtonDown="Prev_Click" ToolTip="이전">
                        <TextBlock x:Name="PrevText" Text="&#xE76B;" Style="{StaticResource NavGlyph}"/>
                    </Border>
                    <Border x:Name="TodayBtn" Style="{StaticResource NavBtn}" Padding="11,0" Margin="2,0"
                            BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="13"
                            MouseLeftButtonDown="Today_Click" ToolTip="오늘로 이동">
                        <TextBlock x:Name="TodayText" Text="오늘" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="NextBtn" Style="{StaticResource NavBtn}"
                            MouseLeftButtonDown="Next_Click" ToolTip="다음">
                        <TextBlock x:Name="NextText" Text="&#xE76C;" Style="{StaticResource NavGlyph}"/>
                    </Border>
                    <!-- settings gear: icon only; opens the quick menu (see App.ShowQuickMenu) -->
                    <Border x:Name="GearBtn" Style="{StaticResource NavBtn}" Margin="6,0,0,0"
                            MouseLeftButtonDown="Gear_Click" ToolTip="캘린더 설정">
                        <TextBlock x:Name="GearText" Text="&#xE713;" Style="{StaticResource NavGlyph}" FontSize="15"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="GridHost" Grid.Row="1"/>

            <WrapPanel x:Name="CountdownBar" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed"/>

            <TextBlock x:Name="EditHint" Grid.Row="1" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                       Foreground="#FFFFC857" FontSize="13" Background="#AA000000" Padding="8,2"
                       Text="위치/크기 조정: 드래그로 이동 · 테두리/모서리로 크기 조정 · 트레이에서 해제"/>

            <!-- Day editor: a click-away scrim plus the panel itself. Position/size are set in code. -->
            <Grid x:Name="EditorLayer" Grid.RowSpan="3" Visibility="Collapsed">
                <Grid.Resources>
                    <!-- the round-cornered icon buttons under the text (done, colours, repeat, reminder, countdown) -->
                    <Style x:Key="OptBtn" TargetType="Border">
                        <Setter Property="Width" Value="30"/>
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="Margin" Value="0,0,2,0"/>
                        <Setter Property="CornerRadius" Value="5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Background" Value="#01FFFFFF"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="OptGlyph" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Foreground" Value="#FFB8C4D6"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Grid.Resources>
                <Border x:Name="Scrim" Background="#01000000" MouseLeftButtonDown="Scrim_Down"/>
                <Border x:Name="EditorPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="#F2182430" BorderBrush="#FF6EA8FF" BorderThickness="1.5"
                        CornerRadius="8" Padding="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Border x:Name="EditorSave" DockPanel.Dock="Right" Style="{StaticResource OptBtn}" Margin="6,0,0,0"
                                    ToolTip="저장 (Ctrl+Enter)" MouseLeftButtonUp="EditorSave_Click">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource OptGlyph}" Foreground="White"/>
                            </Border>
                            <Border DockPanel.Dock="Left" Width="3" Background="#FF3B82F6" CornerRadius="2" Margin="0,3,8,3"/>
                            <TextBlock x:Name="EditorTitle" Foreground="#FFBFD8FF" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock x:Name="EditorHint" DockPanel.Dock="Bottom" Foreground="#99FFFFFF" FontSize="11" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel x:Name="EditorToolbar" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Border x:Name="BtnDone" Style="{StaticResource OptBtn}" ToolTip="작업 완료 표시" MouseLeftButtonUp="OptDone_Click">
                                <TextBlock x:Name="GlyphDone" Text="&#xE930;" Style="{StaticResource OptGlyph}"/>
                            </Border>
                            <Border x:Name="BtnColor" Style="{StaticResource OptBtn}" ToolTip="텍스트 색상 / 셀 색상" MouseLeftButtonUp="OptColor_Click">
                                <TextBlock x:Name="GlyphColor" Text="&#xE790;" Style="{StaticResource OptGlyph}"/>
                            </Border>
                            <Border x:Name="BtnRepeat" Style="{StaticResource OptBtn}" ToolTip="작업 반복" MouseLeftButtonUp="OptRepeat_Click">
                                <TextBlock x:Name="GlyphRepeat" Text="&#xE8EE;" Style="{StaticResource OptGlyph}"/>
                            </Border>
                            <Border x:Name="BtnReminder" Style="{StaticResource OptBtn}" ToolTip="알림" MouseLeftButtonUp="OptReminder_Click">
                                <TextBlock x:Name="GlyphReminder" Text="&#xEA8F;" Style="{StaticResource OptGlyph}"/>
                            </Border>
                            <Border x:Name="BtnCountdown" Style="{StaticResource OptBtn}" ToolTip="기념일까지 카운트 다운" MouseLeftButtonUp="OptCountdown_Click">
                                <TextBlock x:Name="GlyphCountdown" Text="&#xE916;" Style="{StaticResource OptGlyph}"/>
                            </Border>
                        </StackPanel>
                        <!-- one paragraph per item: text colour, strike-through and cell colour show the item's state -->
                        <RichTextBox x:Name="EditorBox" AcceptsReturn="True" AcceptsTab="False" SpellCheck.IsEnabled="False"
                                     VerticalScrollBarVisibility="Auto" Background="#33FFFFFF" Foreground="White"
                                     CaretBrush="White" BorderThickness="0" Padding="4"
                                     PreviewKeyDown="EditorBox_PreviewKeyDown" SelectionChanged="EditorBox_SelectionChanged"
                                     TextChanged="EditorBox_TextChanged">
                            <RichTextBox.Resources>
                                <Style TargetType="Paragraph">
                                    <Setter Property="Margin" Value="0,0,0,1"/>
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        </Border>
        <!-- Position/size adjustment overlay: 4-sided dashed border + 8-way resize handles -->
        <Grid x:Name="EditOverlay" Visibility="Collapsed" Margin="-1">
            <Grid.Resources>
                <Style TargetType="Thumb">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Rectangle IsHitTestVisible="False" Stroke="#E6FFFFFF" StrokeThickness="1.5"
                       StrokeDashArray="3,2" RadiusX="13.5" RadiusY="13.5"/>
            <Thumb VerticalAlignment="Top" Height="8" Cursor="SizeNS" Tag="N" DragDelta="Resize_DragDelta"/>
            <Thumb VerticalAlignment="Bottom" Height="8" Cursor="SizeNS" Tag="S" DragDelta="Resize_DragDelta"/>
            <Thumb HorizontalAlignment="Left" Width="8" Cursor="SizeWE" Tag="W" DragDelta="Resize_DragDelta"/>
            <Thumb HorizontalAlignment="Right" Width="8" Cursor="SizeWE" Tag="E" DragDelta="Resize_DragDelta"/>
            <Thumb HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14" Cursor="SizeNWSE" Tag="NW" DragDelta="Resize_DragDelta"/>
            <Thumb HorizontalAlignment="Right" VerticalAlignment="Top" Width="14" Height="14" Cursor="SizeNESW" Tag="NE" DragDelta="Resize_DragDelta"/>
            <Thumb HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="SizeNESW" Tag="SW" DragDelta="Resize_DragDelta"/>
            <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="SizeNWSE" Tag="SE" DragDelta="Resize_DragDelta"/>
        </Grid>
      </Grid>
    </Border>
</Window>
