<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DeskCal.Core\DeskCal.Core.csproj" />
    <ProjectReference Include="..\DeskCal.Data\DeskCal.Data.csproj" />
    <ProjectReference Include="..\DeskCal.Sync\DeskCal.Sync.csproj" />
    <ProjectReference Include="..\DeskCal.Ai\DeskCal.Ai.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DeskCal.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- WinForms is only used for the tray icon; keep its types (Brushes, Color, FontFamily, KeyEventArgs...) out of the global usings
       so they do not clash with the WPF ones. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <Target Name="OptimizeDesktopPublish" AfterTargets="PrepareForILLink" Condition="'$(PublishTrimmed)' == 'true'">
    <ItemGroup>
      <!-- Unroot optional desktop pack assemblies so ILLink drops them when unused. -->
      <_UnusedDesktop Include="System.Windows.Forms.Design;System.Windows.Forms.Design.Editors;System.Design;System.Drawing.Design;System.Windows.Controls.Ribbon;Microsoft.VisualBasic;Microsoft.VisualBasic.Core;Microsoft.VisualBasic.Forms;WindowsFormsIntegration;System.Windows.Presentation;PresentationFramework.Luna;PresentationFramework.Royale;PresentationFramework.Classic" />
      <TrimmerRootAssembly Remove="@(_UnusedDesktop)" />
      <ManagedAssemblyToLink Condition="'%(Filename)' == 'System.Windows.Forms.Design' or '%(Filename)' == 'System.Windows.Forms.Design.Editors' or '%(Filename)' == 'System.Design' or '%(Filename)' == 'System.Drawing.Design' or '%(Filename)' == 'System.Windows.Controls.Ribbon' or '%(Filename)' == 'Microsoft.VisualBasic' or '%(Filename)' == 'Microsoft.VisualBasic.Core' or '%(Filename)' == 'Microsoft.VisualBasic.Forms' or '%(Filename)' == 'WindowsFormsIntegration' or '%(Filename)' == 'System.Windows.Presentation' or '%(Filename)' == 'PresentationFramework.Luna' or '%(Filename)' == 'PresentationFramework.Royale' or '%(Filename)' == 'PresentationFramework.Classic'">
        <TrimMode>copyused</TrimMode>
      </ManagedAssemblyToLink>
      <!-- Root 100% of all types/members (RootMode=All) in CoreLib + WPF + WinForms + Console/Json and rewrite them from IL (TrimMode=link)
           to strip ~38 MB of ReadyToRun native image bloat while keeping every private/internal reflection & BAML target intact. -->
      <_R2RStrip Include="System.Private.CoreLib;PresentationFramework;PresentationCore;WindowsBase;System.Windows.Forms;System.Windows.Forms.Primitives;System.Private.Windows.Core;ReachFramework;System.Xaml;PresentationUI;System.Console;System.Text.Json" />
      <TrimmerRootAssembly Remove="@(_R2RStrip)" />
      <TrimmerRootAssembly Include="@(_R2RStrip)" RootMode="All" />
      <ManagedAssemblyToLink Condition="'%(Filename)' == 'System.Private.CoreLib' or '%(Filename)' == 'PresentationFramework' or '%(Filename)' == 'PresentationCore' or '%(Filename)' == 'WindowsBase' or '%(Filename)' == 'System.Windows.Forms' or '%(Filename)' == 'System.Windows.Forms.Primitives' or '%(Filename)' == 'System.Private.Windows.Core' or '%(Filename)' == 'ReachFramework' or '%(Filename)' == 'System.Xaml' or '%(Filename)' == 'PresentationUI' or '%(Filename)' == 'System.Console' or '%(Filename)' == 'System.Text.Json'">
        <TrimMode>link</TrimMode>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>

  <Target Name="PrunePublishArtifacts" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <!-- Exclude Visual Studio design-time DLLs and external crash-dump/debugger engines from the release payload. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'System.Windows.Forms.Design' or '%(Filename)' == 'System.Windows.Forms.Design.Editors' or '%(Filename)' == 'System.Windows.Forms.Design.resources' or '%(Filename)' == 'System.Design' or '%(Filename)' == 'System.Drawing.Design' or '%(Filename)' == 'System.Windows.Controls.Ribbon' or '%(Filename)' == 'Microsoft.VisualBasic' or '%(Filename)' == 'Microsoft.VisualBasic.Core' or '%(Filename)' == 'Microsoft.VisualBasic.Forms' or '%(Filename)' == 'Microsoft.DiaSymReader.Native.amd64' or '%(Filename)' == 'mscordbi' or '%(Filename)' == 'mscordaccore' or '%(Filename)' == 'createdump' or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore_'))" />
    </ItemGroup>
  </Target>

</Project>
