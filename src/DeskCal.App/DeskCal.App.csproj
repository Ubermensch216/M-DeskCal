<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DeskCal.Core\DeskCal.Core.csproj" />
    <ProjectReference Include="..\DeskCal.Data\DeskCal.Data.csproj" />
    <ProjectReference Include="..\DeskCal.Sync\DeskCal.Sync.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DeskCal.App</RootNamespace>
  </PropertyGroup>

  <!-- WinForms is only used for the tray icon; keep its types (Brushes, Color, FontFamily, KeyEventArgs...) out of the global usings
       so they do not clash with the WPF ones. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>

</Project>
