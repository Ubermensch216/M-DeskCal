<Window x:Class="DeskCal.App.EventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="일정" Width="470" Height="660" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
    <DockPanel Margin="16,14,16,14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="DeleteBtn" Content="삭제" Width="72" Margin="0,0,24,0" Click="Delete_Click"/>
            <Button Content="취소" Width="72" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="SaveBtn" Content="저장" Width="72" FontWeight="SemiBold" Click="Save_Click"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="#C62828" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="제목" FontWeight="SemiBold"/>
                <TextBox x:Name="TitleBox" Margin="0,3,0,10" Padding="4"/>

                <TextBlock Text="시작" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,6">
                    <DatePicker x:Name="StartDate" Width="140" SelectedDateChanged="Date_Changed"/>
                    <TextBox x:Name="StartTime" Width="60" Margin="8,0,0,0" Padding="4" TextAlignment="Center" ToolTip="HH:mm"/>
                    <CheckBox x:Name="AllDayBox" Content="종일" Margin="14,0,0,0" VerticalAlignment="Center" Click="AllDay_Click"/>
                </StackPanel>
                <TextBlock Text="종료 (비워 두면 같은 날)" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                    <DatePicker x:Name="EndDate" Width="140"/>
                    <TextBox x:Name="EndTime" Width="60" Margin="8,0,0,0" Padding="4" TextAlignment="Center" ToolTip="HH:mm"/>
                </StackPanel>

                <TextBlock Text="반복" FontWeight="SemiBold"/>
                <ComboBox x:Name="RepeatBox" Margin="0,3,0,6" SelectionChanged="Repeat_Changed"/>
                <StackPanel x:Name="IntervalRow" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="간격" VerticalAlignment="Center"/>
                    <TextBox x:Name="IntervalBox" Width="46" Margin="8,0,6,0" Padding="4" TextAlignment="Center" Text="1"/>
                    <TextBlock x:Name="IntervalUnit" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="WeekdayRow" Orientation="Horizontal" Margin="0,0,0,6"/>
                <ComboBox x:Name="MonthlyModeBox" Margin="0,0,0,6"/>
                <StackPanel x:Name="EndRow" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="반복 종료" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="EndKindBox" Width="110" SelectionChanged="EndKind_Changed"/>
                        <TextBox x:Name="CountBox" Width="46" Margin="8,0,4,0" Padding="4" TextAlignment="Center" Text="10"/>
                        <TextBlock x:Name="CountUnit" Text="회" VerticalAlignment="Center"/>
                        <DatePicker x:Name="UntilDate" Width="140" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="알림" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                    <ComboBox x:Name="ReminderBox" Width="150"/>
                    <StackPanel x:Name="ReminderClockRow" Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="알림 시각" VerticalAlignment="Center"/>
                        <TextBox x:Name="ReminderClock" Width="60" Margin="8,0,0,0" Padding="4" TextAlignment="Center" Text="09:00"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="메모" FontWeight="SemiBold"/>
                <TextBox x:Name="BodyBox" Margin="0,3,0,0" Padding="4" Height="100" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
