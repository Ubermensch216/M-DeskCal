<Window x:Class="DeskCal.App.EventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="일정" Width="510" Height="710" MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        Background="#F4F6FA" Foreground="#1E293B"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2F8CFF"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Background" Value="#2F8CFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D78EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,13">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="9"
                        Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                    <Viewbox Width="18" Height="18">
                        <Path Data="M8 2v3M16 2v3M3 9h18M19 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM12 12v6M9 15h6"
                              Stroke="#2F8CFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"/>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="새 일정" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock Text="날짜, 시간, 반복 규칙 및 알림을 설정합니다" FontSize="12" Foreground="#64748B" Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button x:Name="DeleteBtn" DockPanel.Dock="Left" Content="삭제" Style="{StaticResource DangerBtn}" MinWidth="74" Click="Delete_Click"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" Style="{StaticResource SecondaryBtn}" MinWidth="78" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="SaveBtn" Content="저장" Style="{StaticResource PrimaryBtn}" MinWidth="84" Click="Save_Click"/>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0"/>
            </DockPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,6">
            <StackPanel>
                <!-- Title Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="일정 제목" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TitleBox" FontSize="14" Padding="10,7"/>
                    </StackPanel>
                </Border>

                <!-- Date & Time Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="시작" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <DatePicker x:Name="StartDate" Width="150" SelectedDateChanged="Date_Changed"/>
                            <TextBox x:Name="StartTime" Width="72" Margin="8,0,0,0" TextAlignment="Center" ToolTip="HH:mm"/>
                            <CheckBox x:Name="AllDayBox" Content="종일" Margin="14,0,0,0" VerticalAlignment="Center" Click="AllDay_Click"/>
                        </StackPanel>
                        <TextBlock Text="종료 (비워 두면 같은 날)" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="EndDate" Width="150"/>
                            <TextBox x:Name="EndTime" Width="72" Margin="8,0,0,0" TextAlignment="Center" ToolTip="HH:mm"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Repeat & Reminder Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="반복" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="RepeatBox" Margin="0,0,0,8" Padding="8,5" SelectionChanged="Repeat_Changed"/>
                        <StackPanel x:Name="IntervalRow" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="간격" VerticalAlignment="Center" Foreground="#475569"/>
                            <TextBox x:Name="IntervalBox" Width="52" Margin="8,0,6,0" TextAlignment="Center" Text="1"/>
                            <TextBlock x:Name="IntervalUnit" VerticalAlignment="Center" Foreground="#475569"/>
                        </StackPanel>
                        <StackPanel x:Name="WeekdayRow" Orientation="Horizontal" Margin="0,0,0,8"/>
                        <ComboBox x:Name="MonthlyModeBox" Margin="0,0,0,8" Padding="8,5"/>
                        <StackPanel x:Name="EndRow" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="반복 종료" VerticalAlignment="Center" Foreground="#475569" Margin="0,0,8,0"/>
                                <ComboBox x:Name="EndKindBox" Width="110" Padding="6,4" SelectionChanged="EndKind_Changed"/>
                                <TextBox x:Name="CountBox" Width="52" Margin="8,0,4,0" TextAlignment="Center" Text="10"/>
                                <TextBlock x:Name="CountUnit" Text="회" VerticalAlignment="Center" Foreground="#475569"/>
                                <DatePicker x:Name="UntilDate" Width="140" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="#E2E8F0" Margin="0,4,0,10"/>

                        <TextBlock Text="알림" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="ReminderBox" Width="160" Padding="8,5"/>
                            <StackPanel x:Name="ReminderClockRow" Orientation="Horizontal" Margin="12,0,0,0">
                                <TextBlock Text="알림 시각" VerticalAlignment="Center" Foreground="#475569"/>
                                <TextBox x:Name="ReminderClock" Width="72" Margin="8,0,0,0" TextAlignment="Center" Text="09:00"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Memo Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="메모" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="BodyBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="10,8" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
