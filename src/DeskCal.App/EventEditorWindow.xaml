<Window x:Class="DeskCal.App.EventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="일정" Width="500" Height="590" MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        Background="#F4F6FA" Foreground="#1E293B"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Flat Rounded TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2F8CFF"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Borderless TextBox (for wrapped inputs) -->
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Flat ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#FFFFFF" BorderBrush="#CBD5E1"
                                                BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Width="12" Height="12" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M6 9l6 6 6-6" Stroke="#64748B" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#2F8CFF"/>
                                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="11,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="3">
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                        CornerRadius="8" Padding="4" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14" Color="#0F172A"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Flat DatePicker Wrapper + DatePicker -->
        <Style x:Key="FlatDateBox" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2F8CFF"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2,0"/>
            <Style.Resources>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Foreground" Value="#1E293B"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Card -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 5-Option Flat Icon Tile -->
        <Style x:Key="OptTile" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4,7"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Flat Pill Toggle (All-Day & D-Day display toggles) -->
        <Style x:Key="PillToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="bd" Background="#F1F5F9" BorderBrush="#E2E8F0"
                                BorderThickness="1" CornerRadius="14" Padding="10,4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Weekday Toggle CheckBox -->
        <Style x:Key="WeekdayCircle" TargetType="CheckBox">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="bd" Background="#F8FAFC" BorderBrush="#CBD5E1"
                                BorderThickness="1" CornerRadius="16" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F8CFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2F8CFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Preset Chip Button -->
        <Style x:Key="QuickChip" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer Buttons -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Background" Value="#2F8CFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D78EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Color Accent Strip -->
        <Border x:Name="TopAccentStrip" DockPanel.Dock="Top" Height="3.5" Background="#2F8CFF"/>

        <!-- Compact Icon Header -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,11">
            <DockPanel>
                <Border x:Name="HeaderIconBadge" DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9"
                        Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,10,0">
                    <Viewbox Width="17" Height="17">
                        <Path x:Name="HeaderIconPath"
                              Data="M8 2v3M16 2v3M3 9h18M19 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM12 12v6M9 15h6"
                              Stroke="#2F8CFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"/>
                    </Viewbox>
                </Border>
                <!-- Live status pills on right -->
                <StackPanel x:Name="HeaderBadges" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HeaderDonePill" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#86EFAC"
                            BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="11" Height="11" Margin="0,0,3,0">
                                <Path Data="M20 6L9 17l-5-5" Stroke="#16A34A" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                            </Viewbox>
                            <TextBlock Text="완료" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="HeaderDdayPill" Visibility="Collapsed" Background="#FDF2F8" BorderBrush="#F9A8D4"
                            BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="4,0,0,0">
                        <TextBlock x:Name="HeaderDdayText" Text="D-Day" FontSize="11" FontWeight="Bold" Foreground="#BE185D"/>
                    </Border>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="새 일정" FontSize="15.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock x:Name="HeaderDateSummary" Text="" FontSize="11.5" Foreground="#64748B" Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,11">
            <DockPanel>
                <Button x:Name="DeleteBtn" DockPanel.Dock="Left" Style="{StaticResource DangerBtn}" MinWidth="72" Click="Delete_Click" ToolTip="일정 삭제">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Path Data="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"
                                  Stroke="#DC2626" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                        </Viewbox>
                        <TextBlock Text="삭제" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" Style="{StaticResource SecondaryBtn}" MinWidth="72" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="SaveBtn" Style="{StaticResource PrimaryBtn}" MinWidth="86" Click="Save_Click" ToolTip="저장 (Ctrl+Enter)">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                <Path Data="M20 6L9 17l-5-5" Stroke="#FFFFFF" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/>
                            </Viewbox>
                            <TextBlock Text="저장" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"/>
            </DockPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,4">
            <StackPanel>
                <!-- Card 1: Title + 5-Icon Quick Option Bar -->
                <Border Style="{StaticResource CardBorder}" Padding="14,12,14,12">
                    <StackPanel>
                        <!-- Title Input Row with interactive Done circle & live color accent -->
                        <Border x:Name="TitleFrame" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="9" Padding="8,5" Margin="0,0,0,10">
                            <DockPanel>
                                <!-- Interactive Done Circle -->
                                <Border x:Name="TitleDoneCircle" DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11"
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5"
                                        Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"
                                        ToolTip="완료 표시 토글" MouseLeftButtonUp="OptDone_Click">
                                    <Viewbox x:Name="TitleDoneCheck" Width="12" Height="12" Visibility="Collapsed">
                                        <Path Data="M20 6L9 17l-5-5" Stroke="#FFFFFF" StrokeThickness="2.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/>
                                    </Viewbox>
                                </Border>
                                <!-- Live Color Dot shortcut -->
                                <Border x:Name="TitleColorDot" DockPanel.Dock="Right" Width="12" Height="12" CornerRadius="6"
                                        Background="#2F8CFF" VerticalAlignment="Center" Margin="6,0,2,0" Cursor="Hand"
                                        ToolTip="일정 색상 선택" MouseLeftButtonUp="OptColor_Click"/>
                                <Grid VerticalAlignment="Center">
                                    <TextBlock x:Name="TitlePlaceholder" Text="일정 제목을 입력하세요"
                                               FontSize="14.5" Foreground="#94A3B8" VerticalAlignment="Center"
                                               Margin="3,0,0,0" IsHitTestVisible="False"/>
                                    <TextBox x:Name="TitleBox" Style="{StaticResource BareTextBox}"
                                             FontSize="14.5" FontWeight="SemiBold"
                                             TextChanged="TitleBox_TextChanged"
                                             GotKeyboardFocus="TitleBox_FocusChanged"
                                             LostKeyboardFocus="TitleBox_FocusChanged"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- 5-Icon Quick Option Bar (mirrors day-cell editor: 완료, 색상, 반복, 알림, D-Day) -->
                        <UniformGrid Columns="5" Margin="-3,0,-3,0">
                            <!-- 1. 완료 -->
                            <Border x:Name="OptDoneBtn" Style="{StaticResource OptTile}" ToolTip="완료 체크 표시" MouseLeftButtonUp="OptDone_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,0,3">
                                        <Path x:Name="OptDoneIcon"
                                              Data="M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4L12 14.01l-3-3"
                                              Stroke="#64748B" StrokeThickness="1.9" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"/>
                                    </Viewbox>
                                    <TextBlock x:Name="OptDoneLabel" Text="완료" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#64748B" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. 색상 -->
                            <Border x:Name="OptColorBtn" Style="{StaticResource OptTile}" ToolTip="일정 색상 / 셀 배경색 선택" MouseLeftButtonUp="OptColor_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Grid Width="22" Height="18" Margin="0,0,0,3" HorizontalAlignment="Center">
                                        <Viewbox Width="18" Height="18">
                                            <Path x:Name="OptColorIcon"
                                                  Data="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"
                                                  Stroke="#64748B" StrokeThickness="1.9" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"/>
                                        </Viewbox>
                                        <Border x:Name="OptCellBgDot" Width="8" Height="8" CornerRadius="4"
                                                BorderBrush="#FFFFFF" BorderThickness="1"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock x:Name="OptColorLabel" Text="색상" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#64748B" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- 3. 반복 -->
                            <Border x:Name="OptRepeatBtn" Style="{StaticResource OptTile}" ToolTip="반복 규칙 설정" MouseLeftButtonUp="OptRepeat_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,0,3">
                                        <Path x:Name="OptRepeatIcon"
                                              Data="M17 1l4 4-4 4M3 11V9a4 4 0 0 1 4-4h14M7 23l-4-4 4-4M21 13v2a4 4 0 0 1-4 4H3"
                                              Stroke="#64748B" StrokeThickness="1.9" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"/>
                                    </Viewbox>
                                    <TextBlock x:Name="OptRepeatLabel" Text="반복" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#64748B" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- 4. 알림 -->
                            <Border x:Name="OptReminderBtn" Style="{StaticResource OptTile}" ToolTip="알림 설정" MouseLeftButtonUp="OptReminder_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,0,3">
                                        <Path x:Name="OptReminderIcon"
                                              Data="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"
                                              Stroke="#64748B" StrokeThickness="1.9" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"/>
                                    </Viewbox>
                                    <TextBlock x:Name="OptReminderLabel" Text="알림" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#64748B" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- 5. D-Day -->
                            <Border x:Name="OptDdayBtn" Style="{StaticResource OptTile}" ToolTip="기념일 / D-Day 카운트다운 설정" MouseLeftButtonUp="OptDday_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,0,3">
                                        <Path x:Name="OptDdayIcon"
                                              Data="M10 2h4M12 14l3-3M12 6a8 8 0 1 0 0 16 8 8 0 0 0 0-16z"
                                              Stroke="#64748B" StrokeThickness="1.9" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"/>
                                    </Viewbox>
                                    <TextBlock x:Name="OptDdayLabel" Text="D-Day" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#64748B" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Visual Date & Time -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <!-- Row Header: Clock icon + Duration Pill + All-Day Switch -->
                        <DockPanel Margin="0,0,0,10">
                            <CheckBox x:Name="AllDayBox" DockPanel.Dock="Right" Style="{StaticResource PillToggle}"
                                      Click="AllDay_Click" Checked="AllDay_Changed" Unchecked="AllDay_Changed"
                                      ToolTip="하루 종일 일정">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                        <Path Data="M12 3v2M12 19v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M3 12h2M19 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"
                                              Stroke="{Binding Foreground, ElementName=AllDayBox}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                                    </Viewbox>
                                    <TextBlock Text="종일" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#EFF6FF" Margin="0,0,8,0">
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM12 6v6l4 2"
                                              Stroke="#2F8CFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                                    </Viewbox>
                                </Border>
                                <Border x:Name="DurationBadge" Background="#F1F5F9" CornerRadius="10" Padding="8,2.5" VerticalAlignment="Center">
                                    <TextBlock x:Name="DurationText" Text="1시간" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <!-- Start Row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>
                            <!-- Start green dot/arrow icon -->
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="시작">
                                <Path Data="M8 2v3M16 2v3M3 9h18M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM10 13l5 2.5-5 2.5z"
                                      Stroke="#2F8CFF" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"/>
                            </Viewbox>
                            <Border Grid.Column="1" Style="{StaticResource FlatDateBox}" Margin="6,0,0,0">
                                <DatePicker x:Name="StartDate" SelectedDateChanged="Date_Changed" ToolTip="시작 날짜"/>
                            </Border>
                            <Grid Grid.Column="3">
                                <TextBox x:Name="StartTime" Height="34" Padding="24,6,8,6" TextAlignment="Center"
                                         ToolTip="시작 시각 (HH:mm)" TextChanged="Time_Changed"/>
                                <Viewbox Width="13" Height="13" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False">
                                    <Path Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM12 6v6l3.5 2"
                                          Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                                </Viewbox>
                            </Grid>
                        </Grid>

                        <!-- End Row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>
                            <!-- End arrow/flag icon -->
                            <Viewbox Grid.Column="0" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="종료 (비워 두면 같은 날)">
                                <Path Data="M12 4v14M6 12l6 6 6-6" Stroke="#94A3B8" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/>
                            </Viewbox>
                            <Border Grid.Column="1" Style="{StaticResource FlatDateBox}" Margin="6,0,0,0">
                                <DockPanel>
                                    <Border x:Name="ClearEndDateBtn" DockPanel.Dock="Right" Width="20" Height="20" CornerRadius="10"
                                            Background="#F1F5F9" Margin="2,0,2,0" VerticalAlignment="Center" Cursor="Hand"
                                            Visibility="Collapsed" ToolTip="종료 날짜 비우기 (같은 날)" MouseLeftButtonUp="ClearEndDate_Click">
                                        <Viewbox Width="10" Height="10">
                                            <Path Data="M18 6L6 18M6 6l12 12" Stroke="#64748B" StrokeThickness="2.4" StrokeStartLineCap="Round" Width="24" Height="24"/>
                                        </Viewbox>
                                    </Border>
                                    <DatePicker x:Name="EndDate" SelectedDateChanged="Date_Changed" ToolTip="종료 날짜 (비워 두면 같은 날)"/>
                                </DockPanel>
                            </Border>
                            <Grid Grid.Column="3">
                                <TextBox x:Name="EndTime" Height="34" Padding="24,6,8,6" TextAlignment="Center"
                                         ToolTip="종료 시각 (HH:mm)" TextChanged="Time_Changed"/>
                                <Viewbox Width="13" Height="13" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False">
                                    <Path Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM12 6v6l3.5 2"
                                          Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Dynamic Card 3A: Repeat Settings (opens on Repeat tile click or when repeating) -->
                <Border x:Name="RepeatCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Background="#EFF6FF" Margin="0,0,8,0">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="M17 1l4 4-4 4M3 11V9a4 4 0 0 1 4-4h14M7 23l-4-4 4-4M21 13v2a4 4 0 0 1-4 4H3"
                                          Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="반복" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Quick Repeat Chips -->
                        <WrapPanel x:Name="RepeatChips" Margin="0,0,0,4"/>

                        <!-- Full Repeat Selector (all 11 rules) -->
                        <ComboBox x:Name="RepeatBox" Margin="0,0,0,8" SelectionChanged="Repeat_Changed"/>

                        <!-- Interval Row -->
                        <StackPanel x:Name="IntervalRow" Orientation="Horizontal" Margin="0,0,0,8">
                            <Viewbox Width="14" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" ToolTip="반복 간격">
                                <Path Data="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"
                                      Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" Width="24" Height="24"/>
                            </Viewbox>
                            <TextBox x:Name="IntervalBox" Width="54" Height="30" Padding="4,3" TextAlignment="Center" Text="1"/>
                            <TextBlock x:Name="IntervalUnit" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" Margin="7,0,0,0"/>
                        </StackPanel>

                        <!-- Weekday Circular Toggles -->
                        <StackPanel x:Name="WeekdayRow" Orientation="Horizontal" Margin="0,0,0,8"/>

                        <!-- Monthly Mode -->
                        <ComboBox x:Name="MonthlyModeBox" Margin="0,0,0,8"/>

                        <!-- Repeat End Row -->
                        <StackPanel x:Name="EndRow" Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" ToolTip="반복 종료">
                                <Path Data="M4 22V4M4 4h12l-2 4 2 4H4" Stroke="#64748B" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/>
                            </Viewbox>
                            <ComboBox x:Name="EndKindBox" Width="106" SelectionChanged="EndKind_Changed"/>
                            <TextBox x:Name="CountBox" Width="54" Height="34" Margin="8,0,4,0" TextAlignment="Center" Text="10"/>
                            <TextBlock x:Name="CountUnit" Text="회" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold"/>
                            <Border x:Name="UntilDateWrap" Style="{StaticResource FlatDateBox}" Width="148" Margin="8,0,0,0">
                                <DatePicker x:Name="UntilDate" ToolTip="반복 종료일"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dynamic Card 3B: Reminder Settings (opens on Reminder tile click or when set) -->
                <Border x:Name="ReminderCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Background="#FFFBEB" Margin="0,0,8,0">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"
                                          Stroke="#D97706" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="알림" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Quick Reminder Chips -->
                        <WrapPanel x:Name="ReminderChips" Margin="0,0,0,4"/>

                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="ReminderBox" Width="170"/>
                            <StackPanel x:Name="ReminderClockRow" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0" ToolTip="알림 시각">
                                    <Path Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM12 6v6l4 2"
                                          Stroke="#D97706" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                                </Viewbox>
                                <TextBox x:Name="ReminderClock" Width="78" Height="34" TextAlignment="Center" Text="09:00" ToolTip="알림 시각 (HH:mm)"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dynamic Card 3C: D-Day Settings (opens when D-Day tile is active) -->
                <Border x:Name="DdayCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Background="#FDF2F8" Margin="0,0,8,0">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="M10 2h4M12 14l3-3M12 6a8 8 0 1 0 0 16 8 8 0 0 0 0-16z"
                                          Stroke="#DB2777" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                                </Viewbox>
                            </Border>
                            <Border DockPanel.Dock="Right" Background="#FDF2F8" BorderBrush="#FBCFE8" BorderThickness="1"
                                    CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                                <TextBlock x:Name="DdayPreviewText" Text="D-Day" FontSize="11.5" FontWeight="SemiBold" Foreground="#BE185D"/>
                            </Border>
                            <TextBlock Text="D-Day 카운트다운" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- 5 Flat Icon Type Chips -->
                        <UniformGrid x:Name="DdayTypeGrid" Columns="5" Margin="-3,0,-3,10"/>

                        <!-- Display Target Icon Toggles -->
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="DdayShowCardBox" Style="{StaticResource PillToggle}" IsChecked="True" Margin="0,0,8,0"
                                      ToolTip="바탕화면에 디데이 카드로 표시">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                        <Path Data="M3 4h18a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM8 21h8M12 18v3"
                                              Stroke="{Binding Foreground, ElementName=DdayShowCardBox}"
                                              StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                                    </Viewbox>
                                    <TextBlock Text="바탕화면 카드" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="DdayShowBottomBox" Style="{StaticResource PillToggle}" IsChecked="False"
                                      ToolTip="달력 아래 줄에 표시">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                        <Path Data="M3 4h18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM3 15h18"
                                              Stroke="{Binding Foreground, ElementName=DdayShowBottomBox}"
                                              StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                                    </Viewbox>
                                    <TextBlock Text="달력 하단 줄" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 4: Memo (Icon-led) -->
                <Border Style="{StaticResource CardBorder}" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" ToolTip="메모">
                            <Path Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h5"
                                  Stroke="#94A3B8" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/>
                        </Viewbox>
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <TextBox x:Name="BodyBox" Height="82" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" Padding="10,8" VerticalScrollBarVisibility="Auto"
                                     TextChanged="BodyBox_TextChanged"/>
                            <TextBlock x:Name="BodyPlaceholder" Text="메모를 입력하세요…"
                                       Foreground="#94A3B8" FontSize="13" Margin="12,9,0,0"
                                       VerticalAlignment="Top" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
